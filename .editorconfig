root = true

# Development files only. Sealed research, experiment and release artifacts
# retain their original bytes and must not be reformatted by an editor.
[/{src,packages,scripts,tests,docs}/**.{py,ps1,toml,js,mjs,css,html,md,json,yml,yaml}]
charset = utf-8
end_of_line = lf

[/*.{md,toml,ps1}]
charset = utf-8
end_of_line = lf
