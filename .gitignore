/data/
experiments/**/artifacts/
experiments/*/*/deliveries/*/*/experiments/

# Local runtime state and audit data.
state/

# Local credentials for optional Tushare dataflows.
/.env

# Runtime-only Optuna studies.
experiments/*/*/runtime/*.db
experiments/*/*/runtime/*.db-wal
experiments/*/*/runtime/*.db-shm
experiments/*/*/runtime/*.db-journal

# Batch-owned DFLS cache
/research/S*/data/

# Research data, run state and published machine assets.
/research/S*/assets/
