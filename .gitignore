.venv/
__pycache__/
/.tmp/
/.build/
.worktrees/
.registry.lock
*.py[cod]
*.egg-info/
packages/*/build/
packages/*/dist/

# Local fixed-rule backtest outputs; formal research is tracked in experiments/.
outputs/

# Local market datasets and generated experiment artifacts.
