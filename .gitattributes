# Repository text is LF on every platform; this overrides user core.autocrlf.
* text=auto eol=lf

# Raw market data hashes preserve the exact published bytes.
data/raw/*.csv -text

# Immutable S010 experiment manifests hash the published file bytes.
experiments/S010/** -text -eol

# Immutable S011 experiment manifests hash the published file bytes.
experiments/S011/** -text -eol

# Binary artifacts always retain exact bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.db binary
