{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
          },
          "decimals": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "direction",
          "decimals"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "integer"
          },
          "config_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "layer",
          "config_ids"
        ],
        "additionalProperties": false
      }
    },
    "dominated_by": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "unranked": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "automatic_promotion": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "metrics",
    "layers",
    "dominated_by",
    "unranked",
    "automatic_promotion"
  ],
  "additionalProperties": false
}
