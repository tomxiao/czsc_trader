        "factor_id": "F-PROJECT-ER60",
        "name": "60日效率比",
        "description": "以前一交易日收盘为截止的60日净位移与逐日路径长度之比",
        "information_family": "TREND_REGIME",
        "tags": [
          "daily",
          "ohlcv",
          "regime"
        ],
        "inputs": [
          "daily.close"
        ],
        "provider": "project",
        "implementation": "czsc_trader.regime_weight.lagged_efficiency_ratio",
        "formula": "abs(close_t-1-close_t-61)/sum(abs(diff(close)),t-60..t-1)",
        "availability": "前一交易日收盘后，当前交易日开盘前可用",
        "causality": "标记在交易日T的数值只使用T-1及更早的已完成日线",
        "parameters": {
